# Privy (public app id, safe to ship to the browser; restrict by Allowed origins in the Privy dashboard)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Optional: server-side session cookie (leave empty to skip)
PRIVY_VERIFICATION_KEY=
SESSION_SECRET=

# Optional: data layer tuning
LP_DATA_MAX_POOLS=80
POOL_LPERS_MAX_WALLETS=120
# Pools scanned for the Smart LP leaderboard (top + trending, 24h)
LP_LEADERBOARD_POOLS=40

# RPC for position discovery (getProgramAccounts). Public mainnet by default;
# a Helius/Triton URL removes the heavy throttling.
SOLANA_RPC_URL=
# RPC for transaction history (swap discovery). Defaults to
# https://solana-rpc.publicnode.com, which serves history freely.
SOLANA_TX_RPC_URL=

# Smart Traders scan budget per run
TRADER_TOKENS=16
TRADER_PAIRS_PER_TOKEN=2
TRADER_SIGS_PER_PAIR=1500
TRADER_MAX_TX=25000
# Wallets read in full per run (their own 30-day history) and tx per wallet
TRADER_WALLETS=80
TRADER_WALLET_TX=400
# PredictSmart (Polymarket): candidate wallets analysed per run, closed positions read per wallet
PREDICT_TRADERS=150
PREDICT_CLOSED_ROWS=1500
# PredictSmart Perp tab: accounts analysed per run, fill pages (×100) per account
PERP_TRADERS=150
PERP_FILL_PAGES=3

# Optional: Postgres (Neon / Supabase free tier) to persist snapshots on
# Vercel. Without it snapshots live in data/*.json.
DATABASE_URL=

# Copy trading on Polymarket (worker: pnpm copy:polymarket). Needs DATABASE_URL.
# Secret that encrypts agent private keys at rest (16+ chars).
COPY_KEY_SECRET=
# Polygon RPC for approvals / balances (public by default)
POLYGON_RPC_URL=
# Set to 1 to force every subscription into dry-run regardless of its mode
COPY_FORCE_DRY_RUN=1
