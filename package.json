{
  "name": "lpsmart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "copy:watch": "node --env-file-if-exists=.env --import tsx scripts/copy-worker.ts",
    "test:copy": "node --import tsx --test src/lib/copy-engine/*.test.ts src/lib/copy-engine/**/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "leaderboard:build": "node --env-file-if-exists=.env --import tsx scripts/build-leaderboard.ts",
    "test": "node --import tsx --test src/lib/**/*.test.ts src/lib/*/*.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@privy-io/react-auth": "^3.47.0",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "@stripe/stripe-js": "^1.46.0",
    "axios": "^1.13.6",
    "clsx": "^2.1.1",
    "jose": "^4.15.9",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.71.2",
    "tailwind-merge": "^3.5.0",
    "viem": "^2.57.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "keccak",
      "bufferutil",
      "utf-8-validate"
    ]
